# Application environment
APP_ENV=development

# ------------------------------------------------------------------ #
# Tutor mode
# ------------------------------------------------------------------ #
# Set to true to use a deterministic mock response (no LLM call).
# Set to false to call the configured LLM provider (Gemini primary,
# Groq fallback). Requires the relevant API keys below.
TUTOR_MOCK_MODE=true

# ------------------------------------------------------------------ #
# Provider selection
# ------------------------------------------------------------------ #
# Gemini is the default primary provider.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------ #
# Gemini -- primary LLM provider
# ------------------------------------------------------------------ #
# REQUIRED when TUTOR_MOCK_MODE=false
# NEVER commit a real key to source control.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------ #
# Groq -- fallback LLM provider
# ------------------------------------------------------------------ #
# Used automatically when Gemini returns a recoverable error
# (e.g. HTTP 429 rate limit, timeout, transient failure).
# NEVER commit a real key to source control.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
