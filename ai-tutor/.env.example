# Application environment
APP_ENV=development

# ------------------------------------------------------------------ #
# Tutor mode
# ------------------------------------------------------------------ #
# Set to true to use a deterministic mock response (no LLM call).
# Set to false to call Gemini (requires GEMINI_API_KEY).
TUTOR_MOCK_MODE=false

# ------------------------------------------------------------------ #
# Gemini — Phase 2 LLM provider
# ------------------------------------------------------------------ #
# REQUIRED when TUTOR_MOCK_MODE=false
# NEVER commit a real key to source control.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash


# ------------------------------------------------------------------ #
# Legacy (kept for compatibility; superseded by GEMINI_* above)
# ------------------------------------------------------------------ #
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=your_gemini_api_key_here